   "id": "2cd3306a",
   "metadata": {},
   "source": [
    "### **Tratamiento de variables y clustering de ciudades**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "f998edd3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Preparación de variables para el clustering de ciudades como destinos nómadas digitales\n",
    "# Creamos un dataframe con todas las variables a partir de una copia de df_cities\n",
    "\n",
    "df_clustering = df_cities[['city_name', 'country_name', 'continent'] + nom_features].copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "a350acb6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0\n",
      "(4742, 10)\n"
     ]
    }
   ],
   "source": [
    "print(df_clustering[nom_features].isnull().sum().sum()) # No tiene nulos\n",
    "print(df_clustering.shape) # Tiene todas las ciudades y 10 variables "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "9b2bdcbe",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quitamos outliers en todas las variables agregadas porque puede deformar los clusters posteriores\n",
    "\n",
    "for col in nom_features:\n",
    "    p99 = df_clustering[col].quantile(0.99)\n",
    "    p01 = df_clustering[col].quantile(0.01)\n",
    "    df_clustering[col] = df_clustering[col].clip(lower=p01, upper=p99)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "7741aa3b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Y ahora las escalamos para normalizar los órdenes de magnitud de todas ellas\n",
    "\n",
    "scaler_clustering = StandardScaler()\n",
    "X_clustering = scaler_clustering.fit_transform(df_clustering[nom_features])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "b21a512b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x600 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Método del codo + Silhouette para determinar K óptimo para el etiquetados de ciudades\n",
    "\n",
    "K_range = range(2, 11)\n",
    "inertias = []\n",
    "silhouettes = []\n",
    "\n",
    "for k in K_range:\n",
    "    km = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    labels = km.fit_predict(X_clustering)\n",
    "    inertias.append(km.inertia_)\n",
    "    silhouettes.append(silhouette_score(X_clustering, labels))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "# Método del codo\n",
    "axes[0].plot(K_range, inertias, 'o-', color='blue', linewidth=2, markersize=8)\n",
    "axes[0].set_title('Método del Codo', fontweight='bold')\n",
    "axes[0].set_xlabel('Número de clústers')\n",
    "axes[0].set_ylabel('Inercia')\n",
    "axes[0].set_xticks(list(K_range))\n",
    "\n",
    "# Silhouette Score\n",
    "axes[1].plot(K_range, silhouettes, 'o-', color='green', linewidth=2, markersize=8)\n",
    "axes[1].set_title('Silhouette Score', fontweight='bold')\n",
    "axes[1].set_xlabel('Número de clústers')\n",
    "axes[1].set_ylabel('Silhouette Score')\n",
    "axes[1].set_xticks(list(K_range))\n",
    "\n",
    "fig.suptitle('Selección del número óptimo de clústers', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
