    "def taxperiod_formatter(value):\n",
    "\tif isinstance(value, type(np.nan)):\n",
    "\t\treturn {\n",
    "\t\t\t\"tax_time\": None,\n",
    "\t\t\t\"tax_period\": None\n",
    "\t\t}\n",
    "\n",
    "\tsplit = value.split(\" \")\n",
    "\treturn {\n",
    "\t\t\"tax_time\": split[0],\n",
    "\t\t\"tax_period\": split[1],\n",
    "\t}\n",
    "\n",
    "\n",
    "data = pd.DataFrame(df_merged[\"tax_free_period\"].apply(taxperiod_formatter).tolist())\n",
    "df_merged = pd.concat([df_merged, data], axis=1)"
   ]
