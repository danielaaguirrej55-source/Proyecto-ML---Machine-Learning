   "source": [
    "- Categorizamos la media de tax en `low`, `medium` o `high`:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "7894cc70",
   "metadata": {},
   "outputs": [],
   "source": [
    "def categorize_taxmean(value):\n",
    "    if isinstance(value, str):\n",
    "        return value\n",
    "    elif value < 15:\n",
    "        return \"Low\"\n",
    "    elif value < 30:\n",
    "        return \"Medium\"\n",
    "    else:\n",
    "        return \"High\"\n",
    "\n",
    "df_merged[\"tax_category\"] = df_merged[\"tax_mean\"].apply(categorize_taxmean)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "832dcf59",
   "metadata": {},
   "source": [
    "- Categorizamos tax free en `short`, `medium` o `long`:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "328f7145",
   "metadata": {},
   "outputs": [],
   "source": [
    "def categorize_tax_freeperiod(value):\n",
    "    if isinstance(value, str):\n",
    "        return value\n",
    "    elif value <= 365:\n",
    "        return \"Short\"\n",
    "    elif value <= 1825:\n",
    "        return \"Medium\"\n",
    "    else:\n",
    "        return \"Long\"\n",
    "\n",
    "df_merged[\"tax_free_category\"] = df_merged[\"tax_time\"].apply(categorize_tax_freeperiod)"
   ]
  },
