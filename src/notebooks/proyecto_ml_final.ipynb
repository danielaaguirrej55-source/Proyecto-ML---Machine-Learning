   "source": [
    "def normalize_taxperiod(value):\n",
    "\tif isinstance(value, type(np.nan)):\n",
    "\t\treturn None\n",
    "\n",
    "\tif value:\n",
    "\t\tif \"day\" in value.lower():\n",
    "\t\t\treturn \"day\"\n",
    "\t\telif \"year\" in value.lower() and \"/\" not in value.lower():\n",
    "\t\t\treturn \"year\"\n",
    "\n",
    "df_merged[\"tax_period\"] = df_merged[\"tax_period\"].apply(normalize_taxperiod)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "185a542a-ffa5-4c7a-862c-a1dc83d9fb8e",
   "metadata": {},
   "source": [
    "- Normalizamos la unidad de medida en días:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "e1fc9cdd-be5f-448e-83ad-293a65018223",
