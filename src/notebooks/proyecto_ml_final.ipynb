     "iopub.status.busy": "2026-03-04T00:00:41.365658Z",
     "iopub.status.idle": "2026-03-04T00:00:41.373735Z",
     "shell.execute_reply": "2026-03-04T00:00:41.371513Z",
     "shell.execute_reply.started": "2026-03-04T00:00:41.366097Z"
    }
   },
   "outputs": [],
   "source": [
    "conditions = [\n",
    "\tdf_merged[\"tax_period\"].str.lower() == \"day\",\n",
    "\tdf_merged[\"tax_period\"].str.lower() == \"year\"\n",
    "]\n",
    "\n",
    "choices = [\n",
    "\tdf_merged[\"tax_time\"].astype(float) * 1,\n",
    "\tdf_merged[\"tax_time\"].astype(float) * 365,\n",
    "]\n",
    "\n",
    "df_merged[\"tax_time\"] = np.select(conditions, choices)"
   ]
  },
